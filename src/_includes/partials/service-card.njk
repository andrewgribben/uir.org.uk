<article class="service-card {{ service.className }}">
  <p class="eyebrow">{{ service.eyebrow }}</p>
  <h3>{{ service.title }}</h3>
  <p>{{ service.summary }}</p>
  <a class="text-link text-link-light" href="{{ service.href }}">{{ service.linkLabel }} <span aria-hidden="true">↗</span></a>
</article>
