---
layout: base.njk
---
{% include "partials/hero.njk" %}

<section class="section-wrap detail-intro" id="approach">
  <div class="section-kicker"><span>01</span><span>{{ intro.kicker }}</span></div>
  <div class="detail-copy">
    <h2>{{ intro.heading }}</h2>
    <p class="lead">{{ intro.lead }}</p>
    {% for paragraph in intro.body %}
      <p>{{ paragraph }}</p>
    {% endfor %}
  </div>
</section>

<section class="offer-section" aria-labelledby="{{ offer.titleId }}">
  <div class="section-wrap">
    <div class="section-kicker"><span>02</span><span>{{ offer.kicker }}</span></div>
    <h2 id="{{ offer.titleId }}">{{ offer.heading | safe }}</h2>
    <div class="offer-grid">
      {% for item in offer.items %}
        <article class="offer-card"><span class="offer-number">{{ item.number }}</span><h3>{{ item.title }}</h3><p>{{ item.body }}</p></article>
      {% endfor %}
    </div>
    {% if offer.note %}<p class="content-note">{{ offer.note }}</p>{% endif %}
  </div>
</section>

<section class="portfolio-section section-wrap" aria-labelledby="{{ portfolio.titleId }}">
  <div class="section-kicker"><span>03</span><span>{{ portfolio.kicker }}</span></div>
  <div class="portfolio-content">
    <h2 id="{{ portfolio.titleId }}">{{ portfolio.heading }}</h2>
    {% if portfolio.items and portfolio.items.length %}
      <div class="portfolio-grid">
        {% for item in portfolio.items %}
          <article class="portfolio-card">
            <div class="portfolio-card-top"><span class="portfolio-index">{{ item.index }}</span><span class="portfolio-arrow" aria-hidden="true">↗</span></div>
            <p class="eyebrow">{{ item.eyebrow }}</p>
            <h3>{{ item.title }}</h3>
            <p>{{ item.body }}</p>
            <a class="text-link" href="{{ item.href }}">{{ item.linkLabel }} <span aria-hidden="true">↗</span></a>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="portfolio-empty">{{ portfolio.empty }}</p>
    {% endif %}
  </div>
</section>

<section class="page-cta">
  <div class="section-wrap">
    <p class="eyebrow">{{ cta.eyebrow }}</p>
    <h2>{{ cta.heading | safe }}</h2>
    <a class="button button-light" href="{{ cta.href }}">{{ cta.label }} <span aria-hidden="true">↗</span></a>
  </div>
</section>
